{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pyrechat",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"account_id": "b7b3bc3bf5df1b60ee9b9aaeac93f66c",
	"routes": [
		{ "pattern": "chat.pyrearms.dev", "custom_domain": true }
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/assets/*", "/", "/index.html"]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"upload_source_maps": false,
	"vars": {
		"PUBLIC_APP_NAME": "PyreChat",
		"PUBLIC_APP_URL": "https://chat.pyrearms.dev",
		"EARLY_COHORT": "1",
		"BETA_OPEN": "1",
		"CURSOR_REPO": "https://github.com/MaximusPyre/pyrechat",
		"PLAY_STORE_URL": "https://play.google.com/store/apps/details?id=dev.pyrearms.chat"
	},
	"analytics_engine_datasets": [
		{ "binding": "ANALYTICS", "dataset": "pyrechat_events" }
	],
	"triggers": {
		"crons": ["*/10 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pyrechat",
			"database_id": "eb82e0e7-3bb9-4e9c-8986-1a1622c2ad4a",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "pyrechat-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_ROOM", "class_name": "ChatRoom" },
			{ "name": "USER_HUB", "class_name": "UserHub" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoom", "UserHub"]
		}
	]
}
